# last release; each release has its own DOI too), and that of Google Earth Engine, where MonitorEO computes. Each
# result has also its own references (those of its variables, data and methods): see mo_references().
citHeader("To cite MonitorEO in publications, cite it and Google Earth Engine, where it computes, and the references",
          "of each result (mo_references()):")

bibentry(
  bibtype = "Manual",
  key = "monitoreo",
  title = "MonitorEO",
  author = person("Observatorio de Cambio Global de Sierra Nevada"),
  year = "2026",
  note = "Software",
  publisher = "Zenodo",
  doi = "10.5281/zenodo.23814894",
  url = "https://doi.org/10.5281/zenodo.23814894",
  textVersion = paste("Observatorio de Cambio Global de Sierra Nevada (2026). MonitorEO [Software]. Zenodo.",
                      "https://doi.org/10.5281/zenodo.23814894")
)

